<project xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.inria.mbdo.mission</groupId>
        <artifactId>sysml-mission-generator-root</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>sysml-mission-generator-gradle-plugin</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Core generator dependency -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>sysml-mission-generator</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Gradle API (provided) -->
        <dependency>
            <groupId>dev.gradleplugins</groupId>
            <artifactId>gradle-api</artifactId>
            <version>8.11.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Add the Maven compiler plugin to target Java 21 -->
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.plugin.tools.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>

            <!-- copy reference sysml files from the missions-design-models folder to the fixture project `mission-gradle-project-example` in integration tests-->
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-resource-src</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${basedir}/src/test/resources/mission-gradle-project-example/src/main/sysml</outputDirectory>
							<resources>
								<resource>
									<directory>../missions-design-models</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions> 
			</plugin>
        </plugins>
    </build>
</project>